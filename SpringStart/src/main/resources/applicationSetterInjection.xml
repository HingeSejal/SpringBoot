<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="carSpecification" class="com.SpringInitial.Bean.SetterInjection.Specification">
        <property name="make" value="Toyota"/>
        <property name="model" value="Corolla"/>
    </bean>

    <bean id="myCar" class="com.SpringInitial.Bean.SetterInjection.Car">
<!--        <constructor-arg ref="carSpecification"/>           -->
        <property name="specification" ref="carSpecification"/>
    </bean>
</beans>

